# ── Contact form (Resend) ────────────────────────────────────────────────
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain you verified in Resend
RESEND_FROM_EMAIL=Contact Form <contact@mail.pedrosantos.dev>
# Where submissions land (defaults to pedrocarlos.ti@gmail.com)
RESEND_TO_EMAIL=you@example.com

# ── AI chat ("ask my site" panel, POST /api/ask) ─────────────────────────
# Optional. Without AI_API_KEY the panel falls back to a scripted,
# fully-offline mode built from the site's own content — the site never
# breaks, it just stops being a live model.
AI_API_KEY=
# OpenAI-compatible base URL. Defaults to Groq.
AI_BASE_URL=https://api.groq.com/openai/v1
# Model for the panel. Defaults to llama-3.3-70b-versatile.
AI_MODEL=llama-3.3-70b-versatile

# ── Site ────────────────────────────────────────────────────────────────
# Canonical URL used for metadata, feeds, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://pedrosantos.dev